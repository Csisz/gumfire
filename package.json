{
  "name": "gumfire",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @gumfire/client dev",
    "build": "pnpm -r build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:trig": "node tools/gen-trig-table.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "gen:maps": "node tools/gen-test-maps.mjs",
    "bench:carve": "node tools/bench/run.mjs tools/bench/carve.bench.ts",
    "bench:physics": "node tools/bench/run.mjs tools/bench/physics.bench.ts",
    "bench": "pnpm bench:carve && pnpm bench:physics",
    "dev:sandbox": "pnpm --filter @gumfire/sandbox dev",
    "validate:maps": "node tools/bench/run.mjs tools/bench/mapgen.bench.ts",
    "serve": "pnpm --filter @gumfire/client build && pnpm --filter @gumfire/server build && cd apps/server && STATIC_DIR=../client/dist node dist/server.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
