{
  "id": "acorn_mortar",
  "name": "Acorn Mortar",
  "category": "ballistic",
  "description": "A big acorn that bursts into five little ones on impact. Messy, wide, wind-blown.",
  "input": { "mode": "aimCharge" },
  "launch": { "speedMin": 1.5, "speedMax": 12, "chargeTicks": 60, "muzzleOffset": 12 },
  "projectile": {
    "radius": 3,
    "gravityScale": 1,
    "windFactor": 1,
    "triggers": [{ "kind": "impact", "ignoreOwnerTicks": 6 }],
    "payload": {
      "explosion": { "radius": 30, "damage": 25, "knockback": 1.0, "carve": true },
      "cluster": {
        "count": 5,
        "speed": 4,
        "spreadDegrees": 100,
        "projectile": {
          "radius": 2,
          "gravityScale": 1,
          "windFactor": 0.5,
          "triggers": [{ "kind": "impact" }],
          "payload": { "explosion": { "radius": 22, "damage": 15, "knockback": 0.8, "carve": true } },
          "maxLifeTicks": 600
        }
      }
    },
    "maxLifeTicks": 1500
  },
  "ammo": { "default": 3 },
  "turn": { "endsTurn": true, "shotsPerTurn": 1 }
}
