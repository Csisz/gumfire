{
  "id": "fizz_grenade",
  "name": "Fizz Grenade",
  "category": "ballistic",
  "description": "A shaken soda can. Bounces, rolls, and pops when the fuse runs out (keys 1–5 set the fuse, Alt the bounce).",
  "input": { "mode": "aimCharge" },
  "launch": { "speedMin": 1.5, "speedMax": 13, "chargeTicks": 60, "muzzleOffset": 12 },
  "projectile": {
    "radius": 4,
    "gravityScale": 1,
    "windFactor": 0,
    "triggers": [{ "kind": "fuse", "defaultSeconds": 3, "playerSet": true }],
    "bounce": { "low": 0.35, "high": 0.7, "friction": 0.8 },
    "payload": { "explosion": { "radius": 44, "damage": 45, "knockback": 1.0, "carve": true } },
    "maxLifeTicks": 1000
  },
  "ammo": { "default": "inf" },
  "turn": { "endsTurn": true, "shotsPerTurn": 1 }
}
